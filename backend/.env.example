DATABASE_URL="postgresql://bakery:bakery@localhost:5432/bakery_md?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=3000

# Wi-Fi/network ESC/POS kitchen ticket printer. Leave PRINTER_HOST unset
# to simulate printing (logs the ticket instead) when no physical
# printer is available, e.g. in local dev.
PRINTER_HOST=
PRINTER_PORT=9100

# SMTP for the monthly owner summary email. Leave SMTP_HOST unset to
# simulate sending (logs the email instead) when no mail provider is
# configured, e.g. in local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bakery-md.local

DATABASE_URL="postgresql://bakery:bakery@localhost:5432/bakery_md?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=3000

# The kitchen ticket printer is NOT configured here - the backend never
# talks to it directly (it may be cloud-hosted, with no route into the
# bakery's local network). See bridge/.env.example for PRINTER_HOST/PORT
# and the print bridge that runs at the bakery instead.

# SMTP for the monthly owner summary email. Leave SMTP_HOST unset to
# simulate sending (logs the email instead) when no mail provider is
# configured, e.g. in local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bakery-md.local

DATABASE_URL="postgresql://bakery:bakery@localhost:5432/bakery_md?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=3000

# Wi-Fi/network ESC/POS kitchen ticket printer. Leave PRINTER_HOST unset
# to simulate printing (logs the ticket instead) when no physical
# printer is available, e.g. in local dev.
PRINTER_HOST=
PRINTER_PORT=9100

# The deployed backend's URL (Railway, or wherever it ends up).
API_BASE_URL=https://your-backend.up.railway.app

# A dedicated staff account for the bridge to log in as. Any role with
# SEND_TO_KITCHEN works (Waiter or Cashier) - it does not need to be a
# real person, just an account. Create one via POST /users the same way
# you'd create any staff account, e.g. nationalId "9999999999",
# fullName "Puente de Impresion".
BRIDGE_NATIONAL_ID=9999999999
BRIDGE_PASSWORD=change-me

# The printer's address on the bakery's local Wi-Fi network (its own IP,
# not the backend's). Most ESC/POS network printers use port 9100.
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# How often to check for new tickets. 3000ms is a reasonable default for
# a place this size; lower it if tickets need to appear faster.
POLL_INTERVAL_MS=3000
